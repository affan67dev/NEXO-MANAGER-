# Copy this file to ~/.nexo.env and fill values locally. Never commit ~/.nexo.env.
TELEGRAM_BOT_TOKEN=
NEXO_OWNER_TELEGRAM_USER_ID=

# Hosted AI provider. All values are server-side only.
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_MODEL=
# Optional comma-separated OpenRouter fallback model IDs. Primary remains LLM_MODEL.
LLM_FALLBACK_MODELS=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_SECONDS=30
LLM_RETRIES=1
LLM_BACKOFF_SECONDS=0.5
LLM_CONTEXT_TOKENS=4096
LLM_OUTPUT_TOKENS=512

# Portfolio AI API. Keep these values server-side; never put secrets in browser code.
# Comma-separated exact HTTPS origins allowed to send credentialed browser requests.
# Exact HTTPS origins allowed to send credentialed browser requests. Required in production.
NEXO_PORTFOLIO_ALLOWED_ORIGINS=
# Server-side HMAC secret for the public session cookie. Never expose it to the browser.
NEXO_PORTFOLIO_SESSION_SECRET=
# Production cross-origin cookies require HTTPS. Use false only for local HTTP development.
NEXO_PORTFOLIO_COOKIE_SECURE=true
# Optional safe public Telegram destination for redirect_telegram responses.
NEXO_PORTFOLIO_TELEGRAM_URL=

# Supabase project (server-side only; never commit ~/.nexo.env)
SUPABASE_URL=https://hcxyqietfhgvgtfptonq.supabase.co
SUPABASE_ANON_KEY=

# Public knowledge refresh. Only explicitly public GitHub READMEs are ingested.
# Keep this list deterministic; never include private repositories.
NEXO_PUBLIC_GITHUB_REPOSITORIES=affan67dev,NEXO-MANAGER-,OMNIX,PicSyncApp,ajentic-AI-model
# Optional public HTTPS Portfolio website URL. Leave blank until the public site is verified.
NEXO_PUBLIC_PORTFOLIO_URL=
NEXO_PUBLIC_KNOWLEDGE_REFRESH_ON_STARTUP=true
