# Copy this file to ~/.nexo.env and fill values locally. Never commit ~/.nexo.env.
TELEGRAM_BOT_TOKEN=
NEXO_OWNER_TELEGRAM_USER_ID=
# NEXO uses one already-running local Qwen server.
NEXO_QWEN_URL=http://127.0.0.1:8080/v1/chat/completions
NEXO_QWEN_DISABLE_THINKING=true
NEXO_QWEN_CONTEXT_TOKENS=1024
NEXO_QWEN_OUTPUT_TOKENS=256
NEXO_LLM_READ_TIMEOUT_SECONDS=120
NEXO_LLM_RETRIES=1
NEXO_LLM_BACKOFF_SECONDS=0.35

# Portfolio AI API. Keep this server-side; never put these values in browser code.
# Comma-separated exact HTTPS origins allowed to send credentialed browser requests.
NEXO_PORTFOLIO_ALLOWED_ORIGINS=
# Production cross-origin cookies require HTTPS. Use false only for local HTTP development.
NEXO_PORTFOLIO_COOKIE_SECURE=true
# Optional safe public Telegram destination for redirect_telegram responses.
NEXO_PORTFOLIO_TELEGRAM_URL=
