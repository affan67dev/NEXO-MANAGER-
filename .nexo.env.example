# Copy this file to ~/.nexo.env and fill values locally. Never commit ~/.nexo.env.
TELEGRAM_BOT_TOKEN=
NEXO_OWNER_TELEGRAM_USER_ID=
LLAMA_URL=http://127.0.0.1:8080/v1/chat/completions
# Optional secondary Qwen endpoint. Leave disabled/unset on Android unless a separate
# already-running Qwen server is intentionally provisioned and memory-safe.
NEXO_QWEN_FALLBACK_ENABLED=false
NEXO_QWEN_URL=
NEXO_QWEN_COMPLEXITY_CHARS=3500
# Bounded retry controls. Set retries to 0 or 1 on constrained Android hardware.
NEXO_LLM_RETRIES=1
NEXO_LLM_BACKOFF_SECONDS=0.35
# LLM HTTP read/inference timeout; keep appropriate for local hardware.
NEXO_LLM_READ_TIMEOUT_SECONDS=75
TAVILY_API_KEY=
WHISPER_CPP_BIN=whisper-cli
WHISPER_CPP_MODEL=
NEXO_TTS_COMMAND=
NEXO_BRIEFING_HOUR=9
NEXO_BRIEFING_MINUTE=0
