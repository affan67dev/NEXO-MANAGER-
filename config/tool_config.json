{
  "web_search": {
    "enabled": true,
    "provider": "duckduckgo_html",
    "timeout_seconds": 15,
    "max_results": 5
  },
  "automation": {
    "enabled": true,
    "database": "data/memory.db",
    "allow_arbitrary_shell": false,
    "require_confirmation_for_sensitive_actions": true
  },
  "voice": {
    "stt_enabled": true,
    "tts_enabled": true,
    "wake_word_enabled": true,
    "wake_word": "Hey Alex",
    "active_timeout_seconds": 30
  },
  "android": {
    "enabled": true,
    "allow_arbitrary_shell": false,
    "screen_capture_requires_runtime_support": true,
    "sensitive_actions_require_confirmation": true
  }
}
